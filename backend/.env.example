PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aegis_disaster_response?appName=Cluster0

# Optional
# CORS_ORIGIN=https://<your-username>.github.io       (default: allow all)
# INGEST_KEY=some-long-secret                        (hardware must send it as header x-api-key)
# MAP_CENTER_LAT=22.5726                             (middle of the map — set to where your drone flies)
# MAP_CENTER_LNG=88.3639
# MAP_SPAN_DEG=0.05                                  (map width/height in degrees; 0.05 is roughly 5.5 km)
